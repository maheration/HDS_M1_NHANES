@article{writing_group_for_the_ckd_prognosis_consortium_estimated_2023,
	title = {Estimated {Glomerular} {Filtration} {Rate}, {Albuminuria}, and {Adverse} {Outcomes}: {An} {Individual}-{Participant} {Data} {Meta}-{Analysis}},
	volume = {330},
	issn = {0098-7484},
	shorttitle = {Estimated {Glomerular} {Filtration} {Rate}, {Albuminuria}, and {Adverse} {Outcomes}},
	url = {https://jamanetwork.com/journals/jama/fullarticle/2810033},
	doi = {10.1001/jama.2023.17002},
	abstract = {Importance
              Chronic kidney disease (low estimated glomerular filtration rate [eGFR] or albuminuria) affects approximately 14\% of adults in the US.
            
            
              Objective
              To evaluate associations of lower eGFR based on creatinine alone, lower eGFR based on creatinine combined with cystatin C, and more severe albuminuria with adverse kidney outcomes, cardiovascular outcomes, and other health outcomes.
            
            
              Design, Setting, and Participants
              Individual-participant data meta-analysis of 27 503 140 individuals from 114 global cohorts (eGFR based on creatinine alone) and 720 736 individuals from 20 cohorts (eGFR based on creatinine and cystatin C) and 9 067 753 individuals from 114 cohorts (albuminuria) from 1980 to 2021.
            
            
              Exposures
              The Chronic Kidney Disease Epidemiology Collaboration 2021 equations for eGFR based on creatinine alone and eGFR based on creatinine and cystatin C; and albuminuria estimated as urine albumin to creatinine ratio (UACR).
            
            
              Main Outcomes and Measures
              The risk of kidney failure requiring replacement therapy, all-cause mortality, cardiovascular mortality, acute kidney injury, any hospitalization, coronary heart disease, stroke, heart failure, atrial fibrillation, and peripheral artery disease. The analyses were performed within each cohort and summarized with random-effects meta-analyses.
            
            
              Results
              
                Within the population using eGFR based on creatinine alone (mean age, 54 years [SD, 17 years]; 51\% were women; mean follow-up time, 4.8 years [SD, 3.3 years]), the mean eGFR was 90 mL/min/1.73 m
                2
                (SD, 22 mL/min/1.73 m
                2
                ) and the median UACR was 11 mg/g (IQR, 8-16 mg/g). Within the population using eGFR based on creatinine and cystatin C (mean age, 59 years [SD, 12 years]; 53\% were women; mean follow-up time, 10.8 years [SD, 4.1 years]), the mean eGFR was 88 mL/min/1.73 m
                2
                (SD, 22 mL/min/1.73 m
                2
                ) and the median UACR was 9 mg/g (IQR, 6-18 mg/g). Lower eGFR (whether based on creatinine alone or based on creatinine and cystatin C) and higher UACR were each significantly associated with higher risk for each of the 10 adverse outcomes, including those in the mildest categories of chronic kidney disease. For example, among people with a UACR less than 10 mg/g, an eGFR of 45 to 59 mL/min/1.73 m
                2
                based on creatinine alone was associated with significantly higher hospitalization rates compared with an eGFR of 90 to 104 mL/min/1.73 m
                2
                (adjusted hazard ratio, 1.3 [95\% CI, 1.2-1.3]; 161 vs 79 events per 1000 person-years; excess absolute risk, 22 events per 1000 person-years [95\% CI, 19-25 events per 1000 person-years]).
              
            
            
              Conclusions and Relevance
              In this retrospective analysis of 114 cohorts, lower eGFR based on creatinine alone, lower eGFR based on creatinine and cystatin C, and more severe UACR were each associated with increased rates of 10 adverse outcomes, including adverse kidney outcomes, cardiovascular diseases, and hospitalizations.},
	language = {en},
	number = {13},
	urldate = {2026-11-11},
	journal = {JAMA},
	author = {{Writing Group for the CKD Prognosis Consortium} and Appel, Lawrence J and Grams, Morgan and Woodward, Mark and Harris, Katie and Arima, Hisatomi and Chalmers, John and Yatsuya, Hiroshi and Tamakoshi, Koji and Li, Yuanying and Coresh, Josef and Sang, Yingying and Matsushita, Kunihiro and Polkinghorne, Kevan and Chadban, Steve and Levin, Adeera and Djurdjev, Ognjenka and Tang, Mila and Zhang, Luxia and Wang, Fang and Wang, Jinwei and Zhao, Ming-Hui and Schaeffner, Elke and Ebert, Natalie and Mielke, Nina and Tonelli, Marcello and Lloyd, Anita and Sacks, Frank and Shlipak, Michael G and Bansal, Nisha and Sarnak, Mark and Yamagishi, Kazumasa and Muraki, Isao and Shimizu, Yuji and Iso, Hiroyasu and Fukagawa, Masafumi and Maruyama, Shoichi and Hamano, Takayuki and Fujii, Naohiko and Imaizumi, Takahiro and Alencar De Pinho, Natalia and Metzger, Marie and Stengel, Bénédicte and Hamroun, Aghilès and Massy, Ziad and Jafar, Tazeen H and Jehan, Imtiaz and Hatcher, Juanita and Chaturvedi, Nish and Poulter, Neil and Wheeler, David C and Landray, Martin and Anderson, Amanda and Chen, Jing and Lash, James and Taliercio, Jon and Yang, Peter (Wei) and Tuttle, Katherine and Alicic, Radica and Nicholas, Susanne and Shen, Jenny and Schöttker, Ben and Stocker, Hannah and Rothenbacher, Dietrich and Brenner, Hermann and Levy, Daniel and Hwang, Shih-Jen and Schneider, Markus P and Köttgen, Anna and Meiselbach, Heike and Eckardt, Kai-Uwe and Chang, Alexander R and Green, Jamie A and Kirchner, H Lester and Singh, Gurmukteshwar and Sawhney, Simon and Black, Corri and Wilde, Katie and Marks, Angharad and Bell, Samira and Siddiqui, Moneeza and Palmer, Colin and Pearson, Ewan and Miyazaki, Mariko and Nakayama, Masaaki and Yamamoto, Tae and Yamada, Gen and Ito, Sadayoshi and Cirillo, Massimo and Wang, Angela Yee-Moon and Wu, Henry Hon-Lin and Cheung, Hoi Ching and Ngai, Victoria and Tak, Tang Ka and Garg, Amit X and McArthur, Eric and Young, Ann and Jha, Vivekanand and Yadav, Ashok Kum